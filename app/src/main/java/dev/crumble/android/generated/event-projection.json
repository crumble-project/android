{
  "openapi": "3.1.0",
  "info": {
    "title": "Crumble SSE payloads",
    "version": "6.0.0"
  },
  "components": {
    "schemas": {
      "Citation": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "site": {
            "type": "string"
          }
        },
        "required": [
          "href",
          "title",
          "site"
        ]
      },
      "MessagePresentation": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Citation"
            }
          }
        },
        "required": [
          "text",
          "citations"
        ]
      },
      "TranscriptBlock": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TranscriptTextBlock"
          },
          {
            "$ref": "#/components/schemas/TranscriptThinkingBlock"
          },
          {
            "$ref": "#/components/schemas/TranscriptImageBlock"
          },
          {
            "$ref": "#/components/schemas/TranscriptToolCallBlock"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "text": "#/components/schemas/TranscriptTextBlock",
            "thinking": "#/components/schemas/TranscriptThinkingBlock",
            "image": "#/components/schemas/TranscriptImageBlock",
            "toolCall": "#/components/schemas/TranscriptToolCallBlock"
          }
        }
      },
      "TranscriptImageBlock": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image"
            ]
          },
          "mimeType": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "mimeType"
        ]
      },
      "TranscriptTextBlock": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ]
      },
      "TranscriptThinkingBlock": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "thinking"
            ]
          },
          "thinking": {
            "type": "string"
          },
          "redacted": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "thinking"
        ]
      },
      "TranscriptToolCallBlock": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "toolCall"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "type",
          "id",
          "name",
          "arguments"
        ]
      },
      "SnapshotEventPayload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "entryId": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TranscriptBlock"
                  }
                },
                "stopReason": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "number"
                },
                "kind": {
                  "type": "string"
                },
                "replyTo": {
                  "type": "string"
                },
                "replyPreview": {
                  "type": "string"
                },
                "origin": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "agentId": {
                      "type": "string"
                    },
                    "via": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": true
                },
                "communication": {
                  "type": "object",
                  "properties": {
                    "executionId": {
                      "type": "string"
                    },
                    "fromAgentId": {
                      "type": "string"
                    },
                    "fromName": {
                      "type": "string"
                    },
                    "toAgentId": {
                      "type": "string"
                    },
                    "toName": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "sent",
                        "done",
                        "failed",
                        "cancelled"
                      ]
                    }
                  },
                  "required": [
                    "executionId",
                    "fromAgentId",
                    "fromName",
                    "toAgentId",
                    "toName",
                    "status"
                  ],
                  "additionalProperties": true
                },
                "jobQuestion": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "job": {
                      "type": "string"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "multiple": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "job"
                  ],
                  "additionalProperties": true
                },
                "heldAction": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "job": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "job"
                  ],
                  "additionalProperties": true
                },
                "call": {
                  "type": "object",
                  "properties": {
                    "callId": {
                      "type": "string"
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "inbound",
                        "outbound"
                      ]
                    },
                    "callee": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "callId",
                    "direction"
                  ],
                  "additionalProperties": true
                },
                "attachments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "mimeType": {
                        "type": "string"
                      },
                      "size": {
                        "type": "number"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "image",
                          "text"
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "mimeType",
                      "size",
                      "kind"
                    ],
                    "additionalProperties": true
                  }
                },
                "toolCallId": {
                  "type": "string"
                },
                "toolName": {
                  "type": "string"
                },
                "isError": {
                  "type": "boolean"
                },
                "toolDetails": {},
                "presentation": {
                  "$ref": "#/components/schemas/MessagePresentation"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "url",
                      "title"
                    ],
                    "additionalProperties": true
                  }
                }
              },
              "required": [
                "id",
                "entryId",
                "role",
                "content"
              ],
              "additionalProperties": true
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "oldestEntryId": {
            "type": [
              "string",
              "null"
            ]
          },
          "conversationId": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "conversation": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "agentId": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              },
              "archived": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "agentId",
              "title",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": true
          },
          "live": {},
          "partial": {
            "type": "string"
          },
          "usage": {},
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "failed"
            ]
          },
          "working": {
            "type": "string",
            "enum": [
              "idle",
              "thinking",
              "writing",
              "searching",
              "remembering",
              "tinkering",
              "struggling",
              "failed"
            ]
          },
          "updatedAt": {
            "type": "number"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "messages",
          "hasMore",
          "oldestEntryId",
          "conversationId",
          "agentId",
          "conversation",
          "partial",
          "status",
          "working",
          "updatedAt",
          "error"
        ],
        "additionalProperties": true
      },
      "ActivityEventPayload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "reply"
              },
              "eventId": {
                "type": "string"
              },
              "serverId": {
                "type": "string"
              },
              "agentId": {
                "type": "string"
              },
              "agentName": {
                "type": "string"
              },
              "entryId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "origin": {
                "type": "string"
              },
              "preview": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              },
              "executionId": {
                "type": "string"
              },
              "jobName": {
                "type": "string"
              },
              "groupId": {
                "type": "string"
              },
              "groupName": {
                "type": "string"
              },
              "waitingFor": {
                "type": "string",
                "enum": [
                  "approval",
                  "credential",
                  "login"
                ]
              }
            },
            "required": [
              "type",
              "eventId",
              "serverId",
              "agentId",
              "agentName",
              "entryId",
              "origin",
              "preview",
              "createdAt"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "chat-preview"
              },
              "agentId": {
                "type": "string"
              },
              "agentName": {
                "type": "string"
              },
              "lastMessage": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "agentId",
              "agentName",
              "lastMessage"
            ],
            "additionalProperties": true
          }
        ]
      },
      "HeartbeatEventPayload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    }
  },
  "paths": {}
}
