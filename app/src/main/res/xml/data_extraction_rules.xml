<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Credentials are bound to this device's Keystore, so a backup could never read them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dev.crumble.android.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dev.crumble.android.xml" />
    </device-transfer>
</data-extraction-rules>
